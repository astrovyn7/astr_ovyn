
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#08080b">

<title>ASTROVYN — Converting Curiosity Into Innovations</title>
<meta name="description" content="ASTROVYN is an independent research and innovation community exploring space science, artificial intelligence, robotics, propulsion, quantum physics and future technology.">
<meta name="keywords" content="ASTROVYN, space science, innovation, AI, robotics, research, technology, astronomy">
<meta name="author" content="ASTROVYN">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
:root {
  --bg: #08080b;
  --bg2: #0d0d12;
  --panel: #111117;
  --panel2: #16161e;
  --red: #e63946;
  --red2: #ff5360;
  --white: #f5f5f7;
  --muted: #92929f;
  --line: rgba(255,255,255,.09);
  --glow: rgba(230,57,70,.2);
  --mono: "DM Mono", monospace;
  --heading: "Space Grotesk", sans-serif;
  --body: "Inter", sans-serif;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; scroll-padding-top:90px; }
body {
  background:var(--bg);
  color:var(--white);
  font-family:var(--body);
  line-height:1.7;
  overflow-x:hidden;
}
body::before {
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:50;
  opacity:.12;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");
}
a { color:inherit; text-decoration:none; }
button, input, textarea { font:inherit; }
button { cursor:pointer; }
img, svg { max-width:100%; }
::selection { background:var(--red); color:white; }
.container { width:min(1180px, 90%); margin:auto; }
.section { padding:110px 0; position:relative; }
.section-head { max-width:720px; margin-bottom:52px; }
.eyebrow {
  display:inline-flex; align-items:center; gap:10px;
  font:11px var(--mono); letter-spacing:2.5px;
  color:var(--red2); text-transform:uppercase; margin-bottom:18px;
}
.eyebrow::before { content:""; width:24px; height:1px; background:var(--red); }
h1,h2,h3,h4 { font-family:var(--heading); line-height:1.12; }
h2 { font-size:clamp(2.1rem, 5vw, 3.8rem); letter-spacing:-2px; font-weight:600; }
.section-head p { color:var(--muted); margin-top:20px; max-width:650px; }
.accent { color:var(--red2); }
.muted { color:var(--muted); }
.small-label { font:10px var(--mono); letter-spacing:1.5px; color:var(--muted); text-transform:uppercase; }
.btn {
  display:inline-flex; align-items:center; justify-content:center; gap:10px;
  border:1px solid transparent; padding:13px 20px;
  font-size:12px; font-weight:700; letter-spacing:.3px;
  transition:.3s; border-radius:3px;
}
.btn-primary { background:var(--red); color:white; }
.btn-primary:hover { background:#ff4c5a; transform:translateY(-3px); box-shadow:0 10px 35px var(--glow); }
.btn-outline { border-color:var(--line); background:rgba(255,255,255,.02); }
.btn-outline:hover { border-color:var(--red); color:var(--red2); transform:translateY(-3px); }
.text-link { color:var(--red2); font-size:12px; font-weight:700; }
.text-link span { display:inline-block; transition:.3s; }
.text-link:hover span { transform:translateX(5px); }

/* LOADER */
#loader {
  position:fixed; inset:0; background:#07070a; z-index:2000;
  display:flex; align-items:center; justify-content:center;
  flex-direction:column; transition:opacity .8s, visibility .8s;
}
#loader.done { opacity:0; visibility:hidden; }
.loader-mark { font:700 clamp(30px,8vw,64px) var(--heading); letter-spacing:8px; }
.loader-mark span { color:var(--red); }
.loader-line { width:180px; height:2px; background:#292930; margin-top:25px; overflow:hidden; }
.loader-line::after { content:""; display:block; height:100%; width:40%; background:var(--red); animation:load 1.1s ease-in-out infinite; }
.loader-caption { margin-top:14px; color:var(--muted); font:10px var(--mono); letter-spacing:3px; }
@keyframes load { from {transform:translateX(-100%)} to {transform:translateX(350%)} }

/* NAVIGATION */
header {
  height:76px; position:fixed; top:0; left:0; right:0; z-index:100;
  border-bottom:1px solid transparent; transition:.3s;
}
header.scrolled { background:rgba(8,8,11,.9); backdrop-filter:blur(18px); border-color:var(--line); }
.nav { height:100%; display:flex; justify-content:space-between; align-items:center; }
.logo { display:flex; align-items:center; gap:11px; font:700 19px var(--heading); letter-spacing:2px; }
.logo-symbol {
  width:34px; height:34px; display:grid; place-items:center;
  border:1px solid var(--red); color:var(--red); font-size:19px;
  transform:rotate(45deg);
}
.logo-symbol span { transform:rotate(-45deg); }
.logo small { display:block; font:8px var(--mono); color:var(--muted); letter-spacing:2px; margin-top:-2px; }
.nav-links { display:flex; align-items:center; gap:27px; }
.nav-links a { font-size:11px; color:#b9b9c3; transition:.25s; }
.nav-links a:hover { color:white; }
.nav-links .nav-cta { padding:10px 14px; border:1px solid rgba(230,57,70,.55); color:white; }
.menu-toggle { display:none; border:0; color:white; background:none; font-size:25px; }

/* HERO */
.hero {
  min-height:100vh; padding:150px 0 90px; display:flex; align-items:center;
  position:relative; overflow:hidden;
  background:
    radial-gradient(ellipse at 76% 42%, rgba(95,14,28,.2), transparent 42%),
    linear-gradient(180deg,#09090d 0%,#08080b 100%);
}
.hero::before {
  content:""; position:absolute; inset:0; pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
  background-size:65px 65px;
  mask-image:linear-gradient(to bottom,black,transparent 90%);
}
.hero-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:35px; align-items:center; position:relative; z-index:2; }
.hero-copy { max-width:670px; }
.status { display:inline-flex; align-items:center; gap:10px; font:10px var(--mono); color:#c4c4ce; letter-spacing:1.5px; border:1px solid var(--line); padding:8px 12px; margin-bottom:28px; }
.status-dot { width:7px; height:7px; background:#65d6a0; border-radius:50%; box-shadow:0 0 12px #65d6a0; animation:pulse 2s infinite; }
@keyframes pulse { 50% { opacity:.35; box-shadow:0 0 2px #65d6a0; } }
.hero h1 { font-size:clamp(3.3rem,7.5vw,7rem); line-height:.95; letter-spacing:-5px; font-weight:700; }
.hero h1 .outline { color:transparent; -webkit-text-stroke:1px #f1f1f3; }
.hero h1 .red { color:var(--red); }
.hero-subtitle { font-size:clamp(14px,1.5vw,17px); color:#b3b3bf; margin-top:25px; max-width:480px; }
.hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:32px; }
.hero-meta { display:flex; flex-wrap:wrap; gap:28px; margin-top:50px; }
.meta-item { border-left:1px solid var(--red); padding-left:12px; }
.meta-item strong { display:block; font:12px var(--mono); color:#eee; }
.meta-item span { font-size:10px; color:var(--muted); }

/* ORBIT ART */
.universe { position:relative; width:min(100%,520px); aspect-ratio:1; margin:auto; display:grid; place-items:center; }
.universe::before { content:""; position:absolute; width:82%; height:82%; border-radius:50%; background:radial-gradient(circle,rgba(157,25,46,.17),transparent 68%); filter:blur(15px); }
.orbit { position:absolute; border:1px solid rgba(255,255,255,.15); border-radius:50%; transform:rotate(-27deg); }
.orbit.one { width:82%; height:33%; animation:orbitSpin 25s linear infinite; }
.orbit.two { width:94%; height:49%; transform:rotate(40deg); border-color:rgba(230,57,70,.35); animation:orbitSpin 35s linear infinite reverse; }
.orbit.three { width:68%; height:68%; transform:rotate(65deg); border-style:dashed; border-color:rgba(255,255,255,.09); animation:orbitSpin 70s linear infinite; }
@keyframes orbitSpin { to { transform:rotate(333deg); } }
.planet {
  width:36%; aspect-ratio:1; border-radius:50%; position:relative; overflow:hidden;
  background:radial-gradient(circle at 30% 25%,#f5b0a0 0%,#c43e4b 20%,#66202e 48%,#160e19 76%);
  box-shadow:inset -25px -20px 35px #030307, inset 8px 6px 15px rgba(255,255,255,.18),0 0 70px rgba(230,57,70,.22);
  animation:planetFloat 6s ease-in-out infinite;
}
.planet::before {
  content:""; position:absolute; inset:-20%; border-radius:50%;
  background:repeating-linear-gradient(12deg,transparent 0 14px,rgba(10,8,15,.32) 15px 18px,transparent 19px 30px);
  transform:rotate(-22deg);
}
.planet::after { content:""; position:absolute; inset:0; border-radius:50%; background:linear-gradient(115deg,transparent 20%,rgba(0,0,0,.12) 45%,rgba(0,0,0,.88) 95%); }
@keyframes planetFloat { 50% { transform:translateY(-13px); } }
.satellite { position:absolute; width:10px; height:10px; background:var(--red2); border-radius:50%; box-shadow:0 0 18px var(--red); top:18%; right:17%; }
.satellite::after { content:""; position:absolute; width:34px; height:1px; background:var(--red2); transform:rotate(-35deg); top:5px; right:5px; }
.star { position:absolute; width:3px; height:3px; background:white; border-radius:50%; box-shadow:0 0 10px white; animation:twinkle 3s infinite; }
.star.s1 { top:15%; left:24%; } .star.s2 { top:73%; left:14%; animation-delay:1s; }
.star.s3 { top:28%; right:9%; animation-delay:2s; } .star.s4 { bottom:15%; right:27%; }
@keyframes twinkle { 50% { opacity:.15; transform:scale(.5); } }
.orbit-label { position:absolute; font:9px var(--mono); color:#aaaab7; letter-spacing:1.5px; }
.orbit-label.l1 { top:13%; left:5%; } .orbit-label.l2 { bottom:17%; right:1%; }
.orbit-label.l3 { bottom:10%; left:23%; color:var(--red2); }
.hero-scroll { position:absolute; bottom:26px; left:50%; transform:translateX(-50%); display:flex; align-items:center; gap:10px; font:9px var(--mono); color:var(--muted); letter-spacing:2px; }
.scroll-line { width:35px; height:1px; background:var(--red); }

/* MARQUEE */
.marquee { border-top:1px solid var(--line); border-bottom:1px solid var(--line); overflow:hidden; padding:18px 0; background:#0b0b10; }
.marquee-track { display:flex; width:max-content; animation:marquee 35s linear infinite; }
.marquee-item { font:11px var(--mono); letter-spacing:2px; color:#c2c2cd; white-space:nowrap; padding:0 28px; }
.marquee-item span { color:var(--red); margin-right:20px; }
@keyframes marquee { to { transform:translateX(-50%); } }

/* ABOUT */
.about-grid { display:grid; grid-template-columns:.8fr 1.2fr; gap:70px; align-items:start; }
.about-visual {
  min-height:410px; position:relative; overflow:hidden; border:1px solid var(--line);
  background:radial-gradient(circle at 50% 50%,rgba(230,57,70,.12),transparent 60%),#0d0d12;
  display:grid; place-items:center;
}
.about-visual::before,.about-visual::after { content:""; position:absolute; border:1px solid rgba(230,57,70,.25); border-radius:50%; width:270px; height:270px; }
.about-visual::after { width:190px; height:190px; border-color:rgba(255,255,255,.12); }
.about-symbol { font:900 110px var(--heading); color:transparent; -webkit-text-stroke:1px var(--red); z-index:2; animation:aboutPulse 4s ease-in-out infinite; }
@keyframes aboutPulse { 50% { text-shadow:0 0 35px rgba(230,57,70,.35); transform:scale(1.04); } }
.visual-corner { position:absolute; font:9px var(--mono); color:var(--muted); letter-spacing:1px; }
.visual-corner.tl { top:18px; left:18px; } .visual-corner.br { bottom:18px; right:18px; }
.about-content h3 { font-size:clamp(25px,3vw,38px); font-weight:500; margin-bottom:22px; }
.about-content p { color:var(--muted); margin-bottom:16px; font-size:14px; }
.about-highlight { border-left:2px solid var(--red); padding:18px 22px; margin:28px 0; background:linear-gradient(90deg,rgba(230,57,70,.08),transparent); color:#ddd; font:500 16px var(--heading); }

/* MISSION */
.mission-section { background:linear-gradient(180deg,#0b0b10,#08080b); border-block:1px solid var(--line); }
.mission-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); }
.mission-card { padding:32px 27px; background:#0c0c11; transition:.35s; }
.mission-card:hover { background:#141117; }
.card-index { color:var(--red); font:11px var(--mono); letter-spacing:2px; margin-bottom:35px; }
.mission-card h3 { font-size:22px; margin-bottom:14px; }
.mission-card p { font-size:13px; color:var(--muted); }
.mission-icon { color:var(--red2); font-size:23px; margin-bottom:18px; }

/* RESEARCH */
.research-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
.research-card {
  min-height:270px; padding:26px; border:1px solid var(--line); background:var(--panel);
  position:relative; overflow:hidden; transition:transform .35s,border-color .35s,background .35s;
}
.research-card::after { content:""; position:absolute; width:150px; height:150px; border:1px solid rgba(230,57,70,.1); border-radius:50%; right:-70px; bottom:-70px; transition:.4s; }
.research-card:hover { transform:translateY(-7px); border-color:rgba(230,57,70,.55); background:#131118; }
.research-card:hover::after { transform:scale(1.6); border-color:rgba(230,57,70,.25); }
.research-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:30px; }
.research-icon { font-size:25px; color:var(--red2); }
.research-number { font:10px var(--mono); color:#62626e; }
.research-card h3 { font-size:21px; margin-bottom:12px; }
.research-card p { color:var(--muted); font-size:12px; }
.tag-row { display:flex; flex-wrap:wrap; gap:7px; margin-top:20px; }
.tag { padding:5px 8px; font:9px var(--mono); color:#b5b5c0; border:1px solid var(--line); }

/* RESEARCH LAB */
.lab-layout { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
.lab-panel { border:1px solid var(--line); background:var(--panel); padding:30px; }
.lab-panel h3 { font-size:24px; margin-bottom:14px; }
.lab-panel p { color:var(--muted); font-size:13px; }
.lab-list { margin-top:22px; display:grid; gap:0; }
.lab-row { display:flex; align-items:flex-start; gap:14px; padding:17px 0; border-top:1px solid var(--line); }
.lab-row .num { color:var(--red); font:11px var(--mono); padding-top:3px; }
.lab-row strong { display:block; font-size:13px; margin-bottom:4px; }
.lab-row span { display:block; color:var(--muted); font-size:11px; }
.terminal { background:#08080b; border:1px solid var(--line); font:11px var(--mono); overflow:hidden; }
.terminal-bar { padding:12px 15px; display:flex; gap:6px; border-bottom:1px solid var(--line); align-items:center; }
.terminal-dot { width:7px; height:7px; border-radius:50%; background:#4a4a54; }
.terminal-title { margin-left:auto; color:var(--muted); font-size:9px; }
.terminal-body { padding:22px; min-height:260px; color:#c5c5d0; }
.terminal-body p { font:11px/2 var(--mono); color:#c5c5d0; }
.terminal-body .prompt { color:var(--red2); }
.terminal-body .comment { color:#777783; }
.terminal-body .success { color:#83d6a5; }
.terminal-body .cursor { display:inline-block; width:7px; height:13px; background:var(--red); vertical-align:middle; animation:blink 1s steps(2) infinite; }
@keyframes blink { 50% { opacity:0; } }

/* PROJECTS */
.projects-section { background:#0a0a0f; border-block:1px solid var(--line); }
.project-filters { display:flex; flex-wrap:wrap; gap:9px; margin-bottom:30px; }
.filter-btn { padding:9px 14px; border:1px solid var(--line); color:#aaaab5; background:transparent; font-size:10px; transition:.25s; }
.filter-btn.active,.filter-btn:hover { background:var(--red); border-color:var(--red); color:white; }
.projects-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
.project-card { border:1px solid var(--line); background:var(--panel); transition:.3s; overflow:hidden; }
.project-card:hover { transform:translateY(-6px); border-color:rgba(230,57,70,.5); }
.project-art { height:185px; position:relative; display:grid; place-items:center; overflow:hidden; background:radial-gradient(circle at 50% 50%,rgba(230,57,70,.15),transparent 60%),#101016; }
.project-art::before { content:""; position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px); background-size:24px 24px; }
.art-orbit { width:115px; height:115px; border:1px solid rgba(230,57,70,.65); border-radius:50%; position:relative; animation:orbitSpin 18s linear infinite; }
.art-orbit::before { content:""; position:absolute; inset:18px -16px; border:1px solid rgba(255,255,255,.35); border-radius:50%; transform:rotate(50deg); }
.art-orbit::after { content:""; position:absolute; width:13px; height:13px; border-radius:50%; background:var(--red2); top:8px; left:22px; box-shadow:0 0 20px var(--red); }
.art-core { position:absolute; width:32px; height:32px; border-radius:50%; background:radial-gradient(circle at 30% 30%,#ff9a9f,var(--red),#47101a); box-shadow:0 0 30px rgba(230,57,70,.4); }
.project-card:nth-child(2) .art-orbit { border-radius:5px; transform:rotate(45deg); }
.project-card:nth-child(2) .art-orbit::before { border-radius:5px; }
.project-card:nth-child(3) .art-orbit { border-style:dashed; border-color:#c3c3ce; }
.project-card:nth-child(4) .art-core { width:52px; height:52px; border-radius:8px; }
.project-card:nth-child(5) .art-orbit { border-color:#8b8b9b; border-width:2px; }
.project-card:nth-child(6) .art-orbit { border-radius:8px; border-color:var(--red2); }
.art-index { position:absolute; top:15px; left:15px; font:9px var(--mono); color:#b2b2bf; letter-spacing:1px; }
.art-type { position:absolute; bottom:13px; right:15px; font:9px var(--mono); color:var(--red2); letter-spacing:1px; }
.project-info { padding:23px; }
.project-info h3 { font-size:19px; margin-bottom:10px; }
.project-info p { color:var(--muted); font-size:12px; min-height:60px; }
.project-footer { margin-top:18px; padding-top:15px; border-top:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; gap:10px; }
.project-status { font:9px var(--mono); color:#c3c3cd; }
.project-status::before { content:""; display:inline-block; width:6px; height:6px; border-radius:50%; background:#d1a75b; margin-right:7px; }
.project-card[hidden] { display:none; }

/* PROCESS */
.process-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
.process-card { padding-top:22px; border-top:1px solid var(--line); position:relative; }
.process-card::before { content:""; position:absolute; top:-2px; left:0; width:35px; height:3px; background:var(--red); transition:.3s; }
.process-card:hover::before { width:100%; }
.process-num { font:11px var(--mono); color:var(--red2); margin-bottom:30px; }
.process-card h3 { font-size:19px; margin-bottom:12px; }
.process-card p { color:var(--muted); font-size:12px; }

/* PRINCIPLES */
.principles { display:grid; grid-template-columns:1fr 1fr; gap:45px; align-items:center; }
.principle-quote { font:500 clamp(28px,4vw,48px)/1.25 var(--heading); letter-spacing:-1.5px; }
.principle-quote span { color:var(--red2); }
.principle-list { display:grid; gap:0; }
.principle-item { padding:19px 0; border-bottom:1px solid var(--line); display:grid; grid-template-columns:32px 1fr; gap:13px; }
.principle-item .sym { color:var(--red); font-size:16px; }
.principle-item h4 { font-size:15px; margin-bottom:5px; }
.principle-item p { color:var(--muted); font-size:12px; }

/* ROADMAP */
.roadmap-section { background:#0b0b10; border-block:1px solid var(--line); }
.roadmap { display:grid; grid-template-columns:repeat(4,1fr); gap:0; position:relative; margin-top:55px; }
.roadmap::before { content:""; position:absolute; top:7px; left:0; right:0; height:1px; background:var(--line); }
.roadmap-step { padding:34px 22px 0 0; position:relative; }
.roadmap-step::before { content:""; position:absolute; top:0; left:0; width:14px; height:14px; background:var(--bg); border:2px solid var(--red); border-radius:50%; z-index:2; }
.roadmap-step:first-child::before { background:var(--red); box-shadow:0 0 15px var(--glow); }
.roadmap-phase { font:10px var(--mono); color:var(--red2); letter-spacing:1px; margin-bottom:15px; }
.roadmap-step h3 { font-size:18px; margin-bottom:12px; }
.roadmap-step p { color:var(--muted); font-size:12px; }

/* COMMUNITY */
.community-banner {
  padding:65px; border:1px solid rgba(230,57,70,.35);
  background:radial-gradient(ellipse at 100% 0%,rgba(230,57,70,.15),transparent 50%),#101015;
  display:grid; grid-template-columns:1fr auto; align-items:center; gap:30px; position:relative; overflow:hidden;
}
.community-banner::after { content:"ASTROVYN"; position:absolute; bottom:-45px; right:-5px; font:900 115px var(--heading); letter-spacing:-5px; color:rgba(255,255,255,.025); pointer-events:none; }
.community-banner h2 { font-size:clamp(30px,4vw,48px); }
.community-banner p { color:var(--muted); margin-top:16px; max-width:570px; font-size:13px; }
.community-banner .btn { position:relative; z-index:2; white-space:nowrap; }

/* FOUNDER */
.founder-grid { display:grid; grid-template-columns:.7fr 1.3fr; gap:65px; align-items:center; }
.founder-card { border:1px solid var(--line); padding:30px; background:var(--panel); position:relative; }
.founder-monogram { height:220px; display:grid; place-items:center; background:radial-gradient(circle,rgba(230,57,70,.15),transparent 70%); border:1px solid var(--line); font:700 90px var(--heading); color:transparent; -webkit-text-stroke:1px var(--red); }
.founder-role { font:10px var(--mono); color:var(--red2); letter-spacing:2px; margin-top:23px; }
.founder-name { font-size:22px; margin-top:8px; }
.founder-content h3 { font-size:clamp(25px,3vw,38px); margin-bottom:20px; }
.founder-content p { color:var(--muted); font-size:13px; margin-bottom:15px; }
.founder-note { margin-top:25px; padding:20px; border-left:2px solid var(--red); background:rgba(230,57,70,.05); font:italic 16px var(--heading); }

/* FAQ */
.faq-list { max-width:850px; }
.faq-item { border-bottom:1px solid var(--line); }
.faq-question { width:100%; display:flex; align-items:center; justify-content:space-between; gap:20px; padding:22px 0; background:none; color:var(--white); border:0; text-align:left; font:500 16px var(--heading); }
.faq-question span:last-child { color:var(--red2); font-size:23px; transition:.3s; }
.faq-answer { max-height:0; overflow:hidden; transition:max-height .35s ease; }
.faq-answer p { padding:0 35px 22px 0; color:var(--muted); font-size:13px; }
.faq-item.open .faq-question span:last-child { transform:rotate(45deg); }
.faq-item.open .faq-answer { max-height:250px; }

/* CONTACT */
.contact-section { background:linear-gradient(180deg,#08080b,#0d0b10); border-top:1px solid var(--line); }
.contact-grid { display:grid; grid-template-columns:.9fr 1.1fr; gap:65px; }
.contact-intro h2 { margin-bottom:22px; }
.contact-intro > p { color:var(--muted); font-size:13px; }
.contact-links { margin-top:32px; display:grid; gap:12px; }
.contact-link { display:flex; align-items:center; gap:14px; padding:15px; border:1px solid var(--line); transition:.25s; }
.contact-link:hover { border-color:var(--red); background:rgba(230,57,70,.04); }
.contact-link .contact-icon { width:36px; height:36px; display:grid; place-items:center; background:#191118; color:var(--red2); font-size:15px; }
.contact-link small { display:block; font:9px var(--mono); letter-spacing:1px; color:var(--muted); }
.contact-link strong { display:block; font-size:12px; margin-top:3px; }
.contact-form { border:1px solid var(--line); background:var(--panel); padding:30px; }
.form-heading { font-size:22px; margin-bottom:7px; }
.form-description { color:var(--muted); font-size:11px; margin-bottom:25px; }
.form-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
.field { margin-bottom:17px; }
.field label { display:block; font:10px var(--mono); color:#b9b9c4; margin-bottom:8px; letter-spacing:.7px; }
.field input,.field textarea,.field select {
  width:100%; border:1px solid var(--line); outline:none; color:white; background:#0a0a0f;
  padding:13px; font-size:12px; border-radius:2px; transition:.25s;
}
.field input:focus,.field textarea:focus,.field select:focus { border-color:var(--red); box-shadow:0 0 0 2px rgba(230,57,70,.08); }
.field textarea { min-height:120px; resize:vertical; }
.field select option { background:#111; }
.form-note { font-size:10px; color:var(--muted); margin-top:12px; }

/* FOOTER */
footer { background:#060609; border-top:1px solid var(--line); padding:50px 0 22px; }
.footer-top { display:grid; grid-template-columns:1.5fr 1fr 1fr 1fr; gap:35px; padding-bottom:40px; }
.footer-brand p { color:var(--muted); font-size:12px; margin-top:18px; max-width:280px; }
.footer-col h4 { font:10px var(--mono); letter-spacing:1.5px; color:#eee; margin-bottom:18px; }
.footer-col a { display:block; font-size:11px; color:var(--muted); margin:10px 0; transition:.2s; }
.footer-col a:hover { color:var(--red2); transform:translateX(3px); }
.footer-bottom { padding-top:20px; border-top:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; gap:20px; color:#777782; font:9px var(--mono); letter-spacing:.5px; }
.back-top { width:35px; height:35px; display:grid; place-items:center; border:1px solid var(--line); color:white; transition:.25s; }
.back-top:hover { background:var(--red); border-color:var(--red); }

/* FLOATING / ANIMATION */
.cursor-glow { position:fixed; width:220px; height:220px; border-radius:50%; pointer-events:none; z-index:0; background:radial-gradient(circle,rgba(230,57,70,.045),transparent 70%); transform:translate(-50%,-50%); }
.reveal { opacity:0; transform:translateY(25px); transition:opacity .8s ease,transform .8s ease; }
.reveal.visible { opacity:1; transform:translateY(0); }
.delay-1 { transition-delay:.1s; } .delay-2 { transition-delay:.2s; } .delay-3 { transition-delay:.3s; }
#backToTop { position:fixed; bottom:22px; right:22px; width:42px; height:42px; display:grid; place-items:center; background:var(--red); color:white; border:0; z-index:90; opacity:0; visibility:hidden; transform:translateY(10px); transition:.3s; }
#backToTop.show { opacity:1; visibility:visible; transform:translateY(0); }
#toast { position:fixed; bottom:25px; left:50%; transform:translate(-50%,20px); background:#18181f; border:1px solid var(--line); color:white; padding:13px 20px; font-size:12px; z-index:300; opacity:0; visibility:hidden; transition:.3s; }
#toast.show { opacity:1; visibility:visible; transform:translate(-50%,0); }

/* RESPONSIVE */
@media(max-width:1000px) {
  .nav-links { gap:15px; }
  .nav-links a { font-size:10px; }
  .hero-grid { grid-template-columns:1fr  .8fr; }
  .about-grid,.founder-grid { gap:35px; }
  .research-grid,.projects-grid { grid-template-columns:repeat(2,1fr); }
  .footer-top { grid-template-columns:1.4fr 1fr 1fr; }
  .footer-brand { grid-column:1/-1; }
}
@media(max-width:760px) {
  .section { padding:78px 0; }
  header { height:68px; }
  .menu-toggle { display:block; }
  .nav-links {
    position:absolute; top:68px; left:0; right:0; padding:22px 5% 28px;
    background:rgba(8,8,11,.98); border-bottom:1px solid var(--line);
    display:none; flex-direction:column; align-items:stretch; gap:0;
  }
  .nav-links.open { display:flex; }
  .nav-links a { padding:13px 0; border-bottom:1px solid rgba(255,255,255,.05); font-size:12px; }
  .nav-links .nav-cta { margin-top:14px; text-align:center; }
  .hero { padding:125px 0 75px; min-height:auto; }
  .hero-grid { grid-template-columns:1fr; }
  .hero h1 { letter-spacing:-3px; }
  .universe { width:min(90%,390px); margin-top:10px; }
  .hero-scroll { display:none; }
  .hero-meta { margin-top:35px; gap:18px; }
  .about-grid,.founder-grid,.contact-grid,.principles,.lab-layout { grid-template-columns:1fr; gap:35px; }
  .about-visual { min-height:300px; }
  .mission-grid { grid-template-columns:1fr; }
  .mission-card { padding:25px; }
  .card-index { margin-bottom:20px; }
  .research-grid,.projects-grid { grid-template-columns:1fr; }
  .research-card { min-height:230px; }
  .project-art { height:210px; }
  .process-grid { grid-template-columns:repeat(2,1fr); gap:28px 18px; }
  .roadmap { grid-template-columns:1fr 1fr; row-gap:35px; }
  .roadmap::before { display:none; }
  .roadmap-step { padding-top:25px; border-top:1px solid var(--line); }
  .roadmap-step::before { top:-7px; }
  .community-banner { grid-template-columns:1fr; padding:32px 24px; }
  .community-banner::after { font-size:75px; bottom:-20px; }
  .community-banner .btn { justify-self:start; }
  .footer-top { grid-template-columns:1fr 1fr; gap:28px; }
  .footer-brand { grid-column:1/-1; }
  .footer-bottom { flex-direction:column; align-items:flex-start; }
  .form-row { grid-template-columns:1fr; gap:0; }
  .contact-form { padding:22px; }
  .cursor-glow { display:none; }
}
@media(max-width:420px) {
  .container { width:90%; }
  .hero h1 { font-size:3.15rem; }
  h2 { letter-spacing:-1px; }
  .hero-meta { gap:13px; }
  .meta-item strong { font-size:10px; }
  .process-grid,.roadmap { grid-template-columns:1fr; }
  .footer-top { grid-template-columns:1fr 1fr; }
  .footer-col h4 { font-size:9px; }
  .footer-col a { font-size:10px; }
}
@media(prefers-reduced-motion:reduce) {
  *,*::before,*::after { animation-duration:.01ms!important; animation-iteration-count:1!important; scroll-behavior:auto!important; transition-duration:.01ms!important; }
  .reveal { opacity:1; transform:none; }
}
</style>
</head>

<body>
<div id="loader" aria-label="Loading ASTROVYN">
  <div class="loader-mark">ASTRO<span>VYN</span></div>
  <div class="loader-line"></div>
  <div class="loader-caption">INITIALIZING EXPLORATION</div>
</div>

<div class="cursor-glow" id="cursorGlow"></div>

<header id="header">
  <div class="container nav">
    <a class="logo" href="#home" aria-label="ASTROVYN home">
      <div class="logo-symbol"><span>✳</span></div>
      <div>ASTROVYN<small>RESEARCH • INNOVATION</small></div>
    </a>

    <button class="menu-toggle" id="menuToggle" aria-label="Open navigation" aria-expanded="false">☰</button>

    <nav class="nav-links" id="navLinks">
      <a href="#about">About</a>
      <a href="#mission">Mission</a>
      <a href="#research">Research</a>
      <a href="#projects">Projects</a>
      <a href="#roadmap">Roadmap</a>
      <a href="#community">Community</a>
      <a href="#contact" class="nav-cta">LET'S CONNECT ↗</a>
    </nav>
  </div>
</header>

<main>
<!-- HERO -->
<section class="hero" id="home">
  <div class="container hero-grid">
    <div class="hero-copy">
      <div class="status"><span class="status-dot"></span> AN INDEPENDENT INNOVATION COMMUNITY</div>
      <div class="eyebrow">THE FUTURE STARTS WITH A QUESTION</div>
      <h1>
        THINK<br>
        <span class="outline">BEYOND</span><br>
        <span class="red">LIMITS.</span>
      </h1>
      <p class="hero-subtitle">Converting Curiosity Into Innovations. A community exploring the unknown, understanding complex ideas, and developing concepts for tomorrow's technology.</p>
      <div class="hero-actions">
        <a href="#research" class="btn btn-primary">EXPLORE OUR WORLD <span>↗</span></a>
        <a href="#about" class="btn btn-outline">DISCOVER ASTROVYN</a>
      </div>
      <div class="hero-meta">
        <div class="meta-item"><strong>01 / EXPLORE</strong><span>Question everything</span></div>
        <div class="meta-item"><strong>02 / RESEARCH</strong><span>Understand deeply</span></div>
        <div class="meta-item"><strong>03 / INNOVATE</strong><span>Build possibilities</span></div>
      </div>
    </div>

    <div class="universe" aria-label="Animated abstract planetary illustration">
      <div class="orbit one"></div>
      <div class="orbit two"></div>
      <div class="orbit three"></div>
      <div class="planet"></div>
      <div class="satellite"></div>
      <div class="star s1"></div><div class="star s2"></div>
      <div class="star s3"></div><div class="star s4"></div>
      <div class="orbit-label l1">UNKNOWN / 001</div>
      <div class="orbit-label l2">EXPLORE THE UNSEEN</div>
      <div class="orbit-label l3">ASTROVYN SYSTEM</div>
    </div>
  </div>
  <div class="hero-scroll"><span class="scroll-line"></span> SCROLL TO EXPLORE <span class="scroll-line"></span></div>
</section>

<!-- MARQUEE -->
<div class="marquee" aria-label="ASTROVYN research topics">
  <div class="marquee-track">
    <div class="marquee-item"><span>✳</span>SPACE SCIENCE</div>
    <div class="marquee-item"><span>✳</span>ARTIFICIAL INTELLIGENCE</div>
    <div class="marquee-item"><span>✳</span>ROBOTICS</div>
    <div class="marquee-item"><span>✳</span>ROCKET PROPULSION</div>
    <div class="marquee-item"><span>✳</span>QUANTUM PHYSICS</div>
    <div class="marquee-item"><span>✳</span>FUTURE TECHNOLOGY</div>
    <div class="marquee-item"><span>✳</span>ENERGY SYSTEMS</div>
    <div class="marquee-item"><span>✳</span>SPACE SCIENCE</div>
    <div class="marquee-item"><span>✳</span>ARTIFICIAL INTELLIGENCE</div>
    <div class="marquee-item"><span>✳</span>ROBOTICS</div>
    <div class="marquee-item"><span>✳</span>ROCKET PROPULSION</div>
    <div class="marquee-item"><span>✳</span>QUANTUM PHYSICS</div>
    <div class="marquee-item"><span>✳</span>FUTURE TECHNOLOGY</div>
    <div class="marquee-item"><span>✳</span>ENERGY SYSTEMS</div>
  </div>
</div>

<!-- ABOUT -->
<section class="section" id="about">
  <div class="container about-grid">
    <div class="about-visual reveal">
      <span class="visual-corner tl">FIG. 001 — OUR IDENTITY</span>
      <div class="about-symbol">A</div>
      <span class="visual-corner br">INDEPENDENT BY DESIGN</span>
    </div>

    <div class="about-content reveal delay-1">
      <div class="eyebrow">01 / WHO WE ARE</div>
      <h2>Curiosity is not the destination. <span class="accent">It's the beginning.</span></h2>
      <p>ASTROVYN is an independent research and innovation community built around a simple idea: meaningful discoveries begin when someone dares to ask a better question.</p>
      <p>We explore the science behind the universe, investigate emerging technologies, break down complex concepts, and develop ideas that can grow into experiments, digital projects, simulations, and practical prototypes.</p>
      <p>Our interests stretch from the enormous scale of galaxies to the tiny world of quantum physics, from intelligent machines to the technologies that may shape humanity's future in space.</p>
      <div class="about-highlight">We don't believe curiosity should end with a search result. We believe it should lead to understanding, experimentation, and creation.</div>
      <a href="#mission" class="text-link">UNDERSTAND OUR PURPOSE <span>→</span></a>
    </div>
  </div>
</section>

<!-- MISSION -->
<section class="section mission-section" id="mission">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">02 / OUR DIRECTION</div>
      <h2>One curiosity.<br> <span class="accent">Infinite possibilities.</span></h2>
      <p>ASTROVYN connects research, creative thinking, and hands-on development through a continuous journey of discovery.</p>
    </div>

    <div class="mission-grid">
      <article class="mission-card reveal">
        <div class="card-index">01 — EXPLORE</div>
        <div class="mission-icon">◎</div>
        <h3>Explore the Unknown</h3>
        <p>Investigate scientific questions, uncover fascinating concepts, and look beyond familiar explanations to understand how the world and universe work.</p>
      </article>
      <article class="mission-card reveal delay-1">
        <div class="card-index">02 — UNDERSTAND</div>
        <div class="mission-icon">⌘</div>
        <h3>Research with Purpose</h3>
        <p>Study reliable information, compare ideas, learn the principles behind technology, and turn complicated topics into clear, meaningful knowledge.</p>
      </article>
      <article class="mission-card reveal delay-2">
        <div class="card-index">03 — CREATE</div>
        <div class="mission-icon">↗</div>
        <h3>Build What Comes Next</h3>
        <p>Transform learning into original concepts, digital experiments, simulations, prototypes, and projects that can be shared and improved.</p>
      </article>
    </div>
  </div>
</section>

<!-- RESEARCH -->
<section class="section" id="research">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">03 / RESEARCH DOMAINS</div>
      <h2>Different fields.<br><span class="accent">A shared horizon.</span></h2>
      <p>Our research interests connect fundamental science with the technologies and ideas that may influence the future. Each domain offers new questions to investigate.</p>
    </div>

    <div class="research-grid">
      <article class="research-card reveal">
        <div class="research-top"><span class="research-icon">✧</span><span class="research-number">DOMAIN / 001</span></div>
        <h3>Space Science & Astronomy</h3>
        <p>Explore planets, stars, galaxies, black holes, cosmic evolution, orbital mechanics, and the scientific missions that expand our understanding of the universe.</p>
        <div class="tag-row"><span class="tag">ASTROPHYSICS</span><span class="tag">PLANETARY SCIENCE</span></div>
      </article>

      <article class="research-card reveal delay-1">
        <div class="research-top"><span class="research-icon">⌬</span><span class="research-number">DOMAIN / 002</span></div>
        <h3>Artificial Intelligence</h3>
        <p>Understand machine learning, neural networks, intelligent agents, computer vision, and how AI systems can help people solve complex problems.</p>
        <div class="tag-row"><span class="tag">MACHINE LEARNING</span><span class="tag">INTELLIGENT SYSTEMS</span></div>
      </article>

      <article class="research-card reveal delay-2">
        <div class="research-top"><span class="research-icon">⎔</span><span class="research-number">DOMAIN / 003</span></div>
        <h3>Robotics & Automation</h3>
        <p>Investigate sensors, control systems, autonomous machines, robotic exploration, and the relationship between hardware, software, and intelligence.</p>
        <div class="tag-row"><span class="tag">AUTONOMY</span><span class="tag">CONTROL SYSTEMS</span></div>
      </article>

      <article class="research-card reveal">
        <div class="research-top"><span class="research-icon">△</span><span class="research-number">DOMAIN / 004</span></div>
        <h3>Rocketry & Propulsion</h3>
        <p>Study the physics of thrust, orbital transfers, launch systems, spacecraft engineering, and the scientific principles behind reaching space.</p>
        <div class="tag-row"><span class="tag">PROPULSION THEORY</span><span class="tag">ORBITAL MECHANICS</span></div>
      </article>

      <article class="research-card reveal delay-1">
        <div class="research-top"><span class="research-icon">◈</span><span class="research-number">DOMAIN / 005</span></div>
        <h3>Quantum Physics</h3>
        <p>Explore quantum states, wave-particle duality, superposition, entanglement, and the foundations of emerging quantum technologies.</p>
        <div class="tag-row"><span class="tag">QUANTUM THEORY</span><span class="tag">FUNDAMENTAL PHYSICS</span></div>
      </article>

      <article class="research-card reveal delay-2">
        <div class="research-top"><span class="research-icon">⌁</span><span class="research-number">DOMAIN / 006</span></div>
        <h3>Energy & Sustainability</h3>
        <p>Research renewable energy, batteries, energy storage, efficient systems, and technologies that may support a more sustainable future.</p>
        <div class="tag-row"><span class="tag">ENERGY SYSTEMS</span><span class="tag">SUSTAINABILITY</span></div>
      </article>

      <article class="research-card reveal">
        <div class="research-top"><span class="research-icon">⌘</span><span class="research-number">DOMAIN / 007</span></div>
        <h3>Scientific Computing</h3>
        <p>Use mathematics, coding, data analysis, and simulations to investigate scientific problems and communicate results clearly.</p>
        <div class="tag-row"><span class="tag">SIMULATION</span><span class="tag">DATA ANALYSIS</span></div>
      </article>

      <article class="research-card reveal delay-1">
        <div class="research-top"><span class="research-icon">✳</span><span class="research-number">DOMAIN / 008</span></div>
        <h3>Future Technologies</h3>
        <p>Examine emerging ideas in advanced materials, space infrastructure, human-computer interaction, and technologies still in early development.</p>
        <div class="tag-row"><span class="tag">INNOVATION</span><span class="tag">FUTURE SYSTEMS</span></div>
      </article>

      <article class="research-card reveal delay-2">
        <div class="research-top"><span class="research-icon">⌖</span><span class="research-number">DOMAIN / 009</span></div>
        <h3>Engineering & Design</h3>
        <p>Connect scientific understanding with structured design, technical documentation, prototypes, testing, and iterative problem-solving.</p>
        <div class="tag-row"><span class="tag">PROTOTYPING</span><span class="tag">SYSTEM DESIGN</span></div>
      </article>
    </div>
  </div>
</section>

<!-- LAB -->
<section class="section" id="lab">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">04 / HOW WE THINK</div>
      <h2>From a question<br>to a <span class="accent">working concept.</span></h2>
      <p>Good research is more than collecting interesting facts. It requires careful questions, evidence, critical thinking, and the willingness to revise an idea when the evidence changes.</p>
    </div>

    <div class="lab-layout">
      <div class="lab-panel reveal">
        <h3>The research framework</h3>
        <p>A flexible process for investigating ideas and developing projects responsibly.</p>
        <div class="lab-list">
          <div class="lab-row"><div class="num">01</div><div><strong>Define the question</strong><span>Identify the problem, scope, assumptions, and what needs to be understood.</span></div></div>
          <div class="lab-row"><div class="num">02</div><div><strong>Study the evidence</strong><span>Consult reliable sources, scientific literature, and established principles.</span></div></div>
          <div class="lab-row"><div class="num">03</div><div><strong>Develop the concept</strong><span>Create a hypothesis, design, model, or simulation based on the evidence.</span></div></div>
          <div class="lab-row"><div class="num">04</div><div><strong>Evaluate and improve</strong><span>Review results, document limitations, and identify what should happen next.</span></div></div>
        </div>
      </div>

      <div class="terminal reveal delay-1">
        <div class="terminal-bar">
          <span class="terminal-dot"></span><span class="terminal-dot"></span><span class="terminal-dot"></span>
          <span class="terminal-title">astrovyn / research.log</span>
        </div>
        <div class="terminal-body">
          <p><span class="prompt">astrovyn@research:~$</span> initialize inquiry</p>
          <p class="comment"># Every discovery begins somewhere.</p>
          <p><span class="prompt">[01]</span> Question identified</p>
          <p><span class="prompt">[02]</span> Evidence collected</p>
          <p><span class="prompt">[03]</span> Concept developed</p>
          <p><span class="prompt">[04]</span> Limitations reviewed</p>
          <p class="success">[STATUS] Ready for the next iteration.</p>
          <p><span class="prompt">astrovyn@research:~$</span> <span class="cursor"></span></p>
          <br>
          <p class="comment">/* Knowledge grows when ideas meet evidence. */</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section class="section projects-section" id="projects">
  <div class="container">
    <div class="section-head reveal">
      <div class="eyebrow">05 / THE PROJECT SPACE</div>
      <h2>Ideas deserve<br><span class="accent">room to become real.</span></h2>
      <p>These are potential project directions for exploration, research, and development. A concept is not the same as a completed or tested project; each idea must be researched and validated as it develops.</p>
    </div>

    <div class="project-filters reveal" aria-label="Filter project concepts">
      <button class="filter-btn active" data-filter="all">ALL CONCEPTS</button>
      <button class="filter-btn" data-filter="space">SPACE</button>
      <button class="filter-btn" data-filter="ai">AI & ROBOTICS</button>
      <button class="filter-btn" data-filter="physics">PHYSICS</button>
      <button class="filter-btn" data-filter="energy">ENERGY</button>
    </div>

    <div class="projects-grid">
      <article class="project-card reveal" data-category="space">
        <div class="project-art"><span class="art-index">CONCEPT / 001</span><div class="art-orbit"></div><div class="art-core"></div><span class="art-type">SPACE SCIENCE</span></div>
        <div class="project-info">
          <h3>Orbital Mechanics Explorer</h3>
          <p>An interactive educational simulation illustrating how gravity, velocity, and orbital parameters influence the motion of objects in space.</p>
          <div class="tag-row"><span class="tag">SIMULATION</span><span class="tag">ASTRONOMY</span></div>
          <div class="project-footer"><span class="project-status">CONCEPT STAGE</span><a href="#contact" class="text-link">DISCUSS ↗</a></div>
        </div>
      </article>

      <article class="project-card reveal delay-1" data-category="ai">
        <div class="project-art"><span class="art-index">CONCEPT / 002</span><div class="art-orbit"></div><div class="art-core"></div><span class="art-type">ARTIFICIAL INTELLIGENCE</span></div>
        <div class="project-info">
          <h3>Intelligent Research Assistant</h3>
          <p>A proposed tool to help organize research notes, categorize scientific topics, and summarize information with links to source material.</p>
          <div class="tag-row"><span class="tag">AI</span><span class="tag">KNOWLEDGE SYSTEMS</span></div>
          <div class="project-footer"><span class="project-status">CONCEPT STAGE</span><a href="#contact" class="text-link">DISCUSS ↗</a></div>
        </div>
      </article>

      <article class="project-card reveal delay-2" data-category="physics">
        <div class="project-art"><span class="art-index">CONCEPT / 003</span><div class="art-orbit"></div><div class="art-core"></div><span class="art-type">QUANTUM PHYSICS</span></div>
        <div class="project-info">
          <h3>Quantum Concepts Visualizer</h3>
          <p>An educational visualization that introduces selected quantum concepts through simplified models and clear explanations of their limitations.</p>
          <div class="tag-row"><span class="tag">PHYSICS</span><span class="tag">VISUALIZATION</span></div>
          <div class="project-footer"><span class="project-status">CONCEPT STAGE</span><a href="#contact" class="text-link">DISCUSS ↗</a></div>
        </div>
      </article>

      <article class="project-card reveal" data-category="ai">
        <div class="project-art"><span class="art-index">CONCEPT / 004</span><div class="art-orbit"></div><div class="art-core"></div><span class="art-type">ROBOTICS</span></div>
        <div class="project-info">
          <h3>Autonomous Rover Simulator</h3>
          <p>A simulated rover that navigates a virtual environment, responds to obstacles, and demonstrates basic autonomous decision-making.</p>
          <div class="tag-row"><span class="tag">ROBOTICS</span><span class="tag">AUTONOMY</span></div>
          <div class="project-footer"><span class="project-status">CONCEPT STAGE</span><a href="#contact" class="text-link">DISCUSS ↗</a></div>
        </div>
